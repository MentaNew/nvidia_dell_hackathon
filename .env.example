# Copy to .env — every knob is RESCUEBASE_*. Real env vars override .env.

# Laptop / no-GPU UI work: stub providers (events are labelled "stub (no inference performed)")
# RESCUEBASE_PROVIDER=stub
RESCUEBASE_PROVIDER=openai            # any OpenAI-compatible server: vLLM / NIM / llama.cpp / Ollama

RESCUEBASE_VLM_URL=http://127.0.0.1:8001/v1
RESCUEBASE_VLM_MODEL=qwen3-vl
# Reasoning defaults to the VLM until Nemotron is up; then point it at :8002
# RESCUEBASE_LLM_URL=http://127.0.0.1:8002/v1
# RESCUEBASE_LLM_MODEL=nemotron-nano
RESCUEBASE_STT_URL=http://127.0.0.1:8003/v1
RESCUEBASE_STT_MODEL=whisper-large-v3-turbo
RESCUEBASE_EMBED_URL=http://127.0.0.1:8004/v1
RESCUEBASE_EMBED_MODEL=nemotron-embed
RESCUEBASE_THINKING=0                 # 1 = let the reasoning model <think> (slower)

RESCUEBASE_MONGO_URL=mongodb://127.0.0.1:27017   # empty value forces SQLite
RESCUEBASE_INCIDENT=demo-incident
RESCUEBASE_INCIDENT_NAME=DEMO INCIDENT (simulated operational metadata)
RESCUEBASE_DEMO=1                     # enables POST /api/demo/reset
RESCUEBASE_NET_PROBE=http://connectivitycheck.gstatic.com/generate_204   # HTTP URL that defines "external network" (any status <400 = ONLINE)
# RESCUEBASE_MAP_BOUNDS=min_lon,min_lat,max_lon,max_lat   # georeference data/map.png for pins
# RESCUEBASE_MODEL_ROOT=/mnt/<ssd>/GB10_ARSENAL/models     # used by scripts/serve_models.sh only
